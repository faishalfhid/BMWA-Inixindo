<%- include('partials/header') %>
<main class="container">
<h2>Edit Barang</h2>
<% if (errors.length) { %>
  <div class="alert alert-danger" role="alert">
    <ul class="mb-0">
      <% errors.forEach(err => { %><li><%= err.msg %></li><% }); %>
    </ul>
  </div>
<% } %>
<form action="/barang/edit/<%= b.id %>" method="POST">
  <label for="nama" class="form-label">Nama barang</label>
  <input id="nama" type="text" name="nama" required class="form-control mb-2"
         value="<%= b.nama || '' %>">
  <label for="harga" class="form-label">Harga dalam rupiah</label>
  <input id="harga" type="number" name="harga" min="0" max="2147483647" step="1" required
         class="form-control mb-2" value="<%= b.harga ?? '' %>">
  <label for="stok" class="form-label">Stok</label>
  <input id="stok" type="number" name="stok" min="0" max="2147483647" step="1" required
         class="form-control mb-2" value="<%= b.stok ?? '' %>">
  <button type="submit" class="btn btn-success">Simpan</button>
  <a href="/barang" class="btn btn-secondary">Kembali</a>
</form>
</main>
<%- include('partials/footer') %>
