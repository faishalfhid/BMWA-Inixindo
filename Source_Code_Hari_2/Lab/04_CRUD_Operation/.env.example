# Salin URI Session pooler dari Connect; ganti placeholder dan kata sandi.
# Host harus persis dari dasbor. Encode karakter khusus pada kata sandi.
# Simpan kredensial asli hanya di .env, jangan unggah ke Git.
PORT=3000
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
