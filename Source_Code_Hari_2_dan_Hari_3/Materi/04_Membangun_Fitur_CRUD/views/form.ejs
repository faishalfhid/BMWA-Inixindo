<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Validasi formulir</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
<main class="container mt-5">
<h2>Form Tambah Data</h2>
<% if (errors.length) { %>
  <div class="alert alert-danger" role="alert">
    <ul class="mb-0">
      <% errors.forEach(err => { %><li><%= err.msg %></li><% }); %>
    </ul>
  </div>
<% } %>
<!-- Tipe teks memungkinkan peserta menguji format email yang salah di server. -->
<form action="/submit-form" method="POST">
  <div class="mb-3">
    <label for="nama" class="form-label">Nama</label>
    <input id="nama" name="nama" type="text" class="form-control" value="<%= values.nama || '' %>">
  </div>
  <div class="mb-3">
    <label for="email" class="form-label">Email</label>
    <input id="email" name="email" type="text" class="form-control" value="<%= values.email || '' %>">
  </div>
  <button type="submit" class="btn btn-primary">Kirim</button>
</form>
</main>
</body>
</html>
