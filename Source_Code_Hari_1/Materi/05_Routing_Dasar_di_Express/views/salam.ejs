<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Demo GET dan POST</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet">
</head>
<body>
<main class="container py-4">
  <h1>Contoh GET dan POST</h1>
  <p>GET menampilkan form ini. POST mengirim isian ke server.</p>
  <% if (galat) { %><p class="alert alert-danger" role="alert"><%= galat %></p><% } %>
  <% if (pesan) { %><p class="alert alert-success" role="status"><%= pesan %></p><% } %>
  <form action="/salam" method="post">
    <label for="nama" class="form-label">Nama peserta</label>
    <input id="nama" name="nama" class="form-control mb-3" value="<%= nama %>" maxlength="100" required>
    <button class="btn btn-primary" type="submit">Kirim salam</button>
  </form>
  <a href="/" class="btn btn-secondary mt-3">Kembali</a>
</main>
</body>
</html>
