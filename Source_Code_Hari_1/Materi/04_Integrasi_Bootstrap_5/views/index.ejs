<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Demo komponen Bootstrap 5</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet">
</head>
<body>
<div class="container py-4">
  <div class="row g-4">
    <aside class="col-md-3">
      <nav class="list-group" aria-label="Menu dasbor">
        <a class="list-group-item list-group-item-action" href="#ringkasan">Ringkasan</a>
        <a class="list-group-item list-group-item-action" href="#form">Form</a>
        <a class="list-group-item list-group-item-action" href="#tabel">Tabel</a>
      </nav>
    </aside>
    <main class="col-md-9">
      <div id="ringkasan" class="card shadow mb-4">
        <div class="card-header bg-primary text-white"><h1 class="h4 mb-0">Dashboard Sederhana</h1></div>
        <div class="card-body">
          <h2 class="h5 card-title">Halo, <%= namaPengguna %></h2>
          <p class="card-text">Bootstrap 5 telah berhasil dipasang!</p>
          <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalInfo">Buka modal</button>
        </div>
      </div>
      <section id="form" class="mb-4" aria-labelledby="judulForm">
        <h2 id="judulForm" class="h5">Contoh form</h2>
        <form method="get" action="/">
          <label for="nama" class="form-label">Nama pengguna</label>
          <input id="nama" name="nama" class="form-control mb-2" value="<%= namaPengguna %>" maxlength="100" required>
          <button type="submit" class="btn btn-primary">Tampilkan nama</button>
        </form>
        <p class="form-text">Form GET ini mengubah sapaan dan tidak menyimpan data.</p>
      </section>
      <section id="tabel" aria-labelledby="judulTabel">
        <h2 id="judulTabel" class="h5">Contoh tabel</h2>
        <div class="table-responsive">
          <table class="table table-bordered table-striped">
            <thead class="table-dark"><tr><th scope="col">Komponen</th><th scope="col">Fungsi</th></tr></thead>
            <tbody><tr><td>Card</td><td>Ringkasan informasi</td></tr><tr><td>Modal</td><td>Dialog informasi</td></tr></tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
</div>
<div class="modal fade" id="modalInfo" tabindex="-1" aria-labelledby="judulModal" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header">
      <h2 class="modal-title fs-5" id="judulModal">Informasi pelatihan</h2>
      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
    </div>
    <div class="modal-body">Modal bekerja dengan JavaScript Bootstrap bundle.</div>
    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button></div>
  </div></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
